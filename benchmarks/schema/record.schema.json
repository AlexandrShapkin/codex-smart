{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scenario_id": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "snapshot": {
      "type": "string"
    },
    "cold_warm": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "repetition": {
      "type": "integer"
    },
    "order_seed": {
      "type": "integer"
    },
    "retry_count": {
      "type": "integer"
    },
    "initial_failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "final_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "index_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "bootstrap_seconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "references": {
      "type": [
        "object",
        "null"
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "exit_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "quality_gates": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "quality_pass": {
            "type": "boolean"
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "setup_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "tokens": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cached_input": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "reasoning": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "total": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "fresh_input": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "input",
              "cached_input",
              "output",
              "reasoning",
              "total",
              "fresh_input"
            ]
          },
          "observed_tool_calls": {
            "type": [
              "number",
              "null"
            ]
          },
          "tool_calls": {
            "type": [
              "number",
              "null"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "terminal_status": {
            "enum": [
              "completed",
              "failed",
              "missing"
            ]
          }
        },
        "required": [
          "start",
          "end",
          "duration",
          "exit_status",
          "quality_gates",
          "quality_pass",
          "failure_reason",
          "setup_seconds",
          "tokens",
          "observed_tool_calls",
          "tool_calls",
          "errors",
          "terminal_status"
        ]
      }
    },
    "quality_pass": {
      "type": "boolean"
    }
  },
  "required": [
    "scenario_id",
    "variant",
    "snapshot",
    "cold_warm",
    "schema_version",
    "repetition",
    "order_seed",
    "retry_count",
    "initial_failure",
    "final_status",
    "references",
    "attempts",
    "quality_pass"
  ]
}
