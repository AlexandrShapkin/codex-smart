{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "variants",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "variants": {
      "type": "object",
      "required": [
        "legacy",
        "native",
        "router-v2",
        "vanilla"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "available"
        ],
        "properties": {
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "task_class",
          "source",
          "snapshot",
          "fixture",
          "setup",
          "prompt",
          "grader",
          "allowed_variants",
          "required_capabilities",
          "quality_gates"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "task_class": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "snapshot": {
            "type": "string"
          },
          "fixture": {
            "type": "string"
          },
          "setup": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "grader": {
            "type": "string"
          },
          "allowed_variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quality_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
